# Copy to .env and fill in. Never commit .env.

# Admin login for /admin (single owner)
ADMIN_PASSWORD=choose-a-strong-password
SECRET_KEY=any-long-random-string

# WhatsApp via CallMeBot (free): your number in international format + the API key CallMeBot sends you
WHATSAPP_PHONE=+2010xxxxxxxx
CALLMEBOT_APIKEY=
DAILY_BRIEFING_TIME=08:00
TIMEZONE=Africa/Cairo

# Local models (Ollama)
OLLAMA_URL=http://127.0.0.1:11434
CHAT_MODEL=qwen3:8b
EMBED_MODEL=bge-m3

# Optional: any Anthropic Messages-compatible API instead of local Ollama for chat
# LLM_PROVIDER=anthropic
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Must match the redirect URI registered in Google Cloud (…/api/google/callback)
PUBLIC_BASE_URL=http://localhost:8000
